{
  "name": "agentflow-ai",
  "version": "1.0.0",
  "description": "Agentic AI Operations Automation Platform (Agentflow_AI)",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm run install:server && npm run install:client",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm start",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run start:server\" \"npm run start:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
