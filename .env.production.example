# ==========================================
# Agentflow_AI Production Environment Config
# ==========================================

# Core Server Settings
PORT=5001
NODE_ENV=production
CLIENT_URL=https://your-domain.com

# Database & Cache (Production MongoDB & Redis)
MONGODB_URI=mongodb://user:securepassword@mongodb:27017/agentflow_ai?authSource=admin
REDIS_URL=redis://:securepassword@redis:6379

# Security & Cryptography
# JWT_SECRET must be at least 32 characters
JWT_SECRET=replace_with_a_super_strong_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CREDENTIAL_ENCRYPTION_KEY must be exactly 64 hex characters (32 bytes AES-256-GCM)
# Generate via: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Providers (Primary & Fallback)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# OAuth Third-Party Integrations
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://your-domain.com/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-domain.com/api/integrations/oauth/slack/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=https://your-domain.com/api/integrations/oauth/discord/callback

GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=https://your-domain.com/api/integrations/oauth/google-sheets/callback

# Frontend Public Variables (for client build/runtime)
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_SOCKET_URL=https://your-domain.com
